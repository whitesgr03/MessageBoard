extends layout

block links
    link(rel='stylesheet', href='/stylesheets/form.css')

block content
    div.formWrap
        form(method="POST" action="/messages/create")
            div.author Author:
                input(type="text" name="username")
            div.message Message:
                input(type="text" name="content")
            div
                button(type="submit") Add message
                a(href="/") Back to board 